! ---------------------------------------------------------------------------
! HEXTOR configuration for the SAMOSA intercomparison
! (Sparse Atmospheric MOdel Sampling Analysis; Haqq-Misra et al. 2022, PSJ 3,
! 260 — a CUISINES model intercomparison project).
!
! This is a TEMPLATE: tools/run_samosa.py fills the placeholder fields for each
! of the protocol's cases and writes the result to input.nml.  The values that
! are NOT braced are the protocol's fixed parameters (Table 2) plus the
! HEXTOR-specific choices documented below.
!
! Protocol fixed parameters (Table 2)
!   host star       3000 K blackbody
!   rotation        15 d, synchronous
!   orbital period  15 d
!   planet          1 M(Earth), 1 R(Earth), 1 g(Earth)
!   atmosphere      N2 background plus CO2 at a fixed partial pressure of
!                   400 ubar (2024 erratum; NOT 400 ppm).  The runner sets
!                   pg0 = pN2 + 4e-4 bar and fco2 = 4e-4 / pg0 per case.
!   surface         aquaplanet, 50 m slab ocean, no ocean heat transport
!
! HEXTOR-specific choices
!   rot / a / msun  A synchronous 15 d rotation is rot = 2*pi/15 d =
!                   4.8483e-6 rad/s.  HEXTOR derives the ORBITAL period from
!                   a and msun (driver.f:499, w = sqrt(G*msun)*a^-1.5), so the
!                   pair below is chosen to give exactly 15 d for a 0.12 Msun
!                   host (typical of a 3000 K M dwarf).  The instellation is
!                   set independently by solarcon, so a and msun affect only
!                   the orbital period, not the energy input.
!   do_longitudinal With this set, the 18 belts are rings of constant angle
!                   from the SUBSTELLAR point rather than latitude bands, and
!                   the insolation becomes s = q*cos(theta) on the dayside and
!                   0 on the night side (driver.f:1314).  This is the
!                   tidally-locked configuration used for THAI.
!   snowalb         0.21.  The protocol specifies two-channel albedos weighted
!                   against the 3000 K spectrum (sea ice 0.65 visible / 0.17
!                   near-IR).  HEXTOR carries ONE broadband surface albedo, so
!                   these are combined with the fraction of a 3000 K blackbody
!                   below 0.7 um (f_vis = 0.083):
!                       ice  = 0.083*0.65 + 0.917*0.17 = 0.21
!                       snow = 0.083*0.97 + 0.917*0.46 = 0.50
!                   Sea ice is the relevant surface on an aquaplanet, so 0.21
!                   is used; HEXTOR sets icealb = snowalb (driver.f:836).  The
!                   published TRAPPIST-1 runs used 0.25 for a 2600 K host; the
!                   value here follows SAMOSA's own specification instead,
!                   since the protocol prescribes the two-channel albedos.  The
!                   red-star ice albedo is far below its Earth value (0.40),
!                   which weakens the ice-albedo feedback — a known and
!                   physical M-dwarf effect, not a tuning choice.
!   ocnalb          0.06, held constant.  Note this needs a radiation table
!                   whose surface-albedo axis reaches open-ocean values; the
!                   legacy 1 bar tables floored at 0.2.
!   cloudir         The table is CLEAR SKY, and cloudir is the only cloud
!                   knob: driver.f:767 applies ir = ir - cloudir, so the
!                   published -35 W/m2 RAISES the outgoing longwave everywhere
!                   (a net cooling).  tools/run_samosa.py defaults to that
!                   published TRAPPIST-1 value for consistency with HEXTOR
!                   4.2.1; --cloudir 0 recovers the pure clear-sky result.
!                   CAVEAT: -35 was calibrated against the THAI Hab1 GCM
!                   ensemble at 1 bar, S = 900 W/m2, around a 2600 K star,
!                   using the old 1 bar lookup table.  Part of it therefore
!                   compensates for that table's biases rather than for
!                   clouds, and none of it was fitted over 0.1-10 bar or
!                   400-2400 W/m2.
!   d0 / diffadj    Two ways to make heat transport scale with pressure, both
!                   supported by tools/run_samosa.py:
!                     --no-diffadj (default): diffadj = .false. and the runner
!                       sets d0 = d0_ref * pg0 per case.  Transport per bar is
!                       carried over from the THAI calibration unchanged.
!                     --diffadj: HEXTOR's own scaling (driver.f:1603),
!                       d = d0 * pg0 * (avemol0/avemol)^2 * (hcp/hcp0) *
!                       (rot0/rot)^2.  Same linear pressure dependence, ~1.10
!                       from composition, and a ROTATION factor of 37 for
!                       TRAPPIST-1e but 225 for a 15 d rotator.  Calibrating
!                       d0 at THAI and transferring it therefore gives ~6x more
!                       transport here than the first option.  The rotation
!                       term is standard EBM physics (slower rotation, weaker
!                       Coriolis, more efficient transport), so which option is
!                       right is a physical question, not a bookkeeping one.
!                     --diffadj --no-rot-scaling: diffadj = .true. with
!                       diffadj_rot = .false., i.e. keep the pressure and
!                       composition scaling and drop the rotation factor.
!                       With SAMOSA's fixed composition this reproduces the
!                       first option exactly, but it expresses the choice
!                       through the model rather than by pre-multiplying d0,
!                       and it differs whenever composition varies.
!                   Either way d0_ref is the single most important free
!                   parameter in this configuration.
!   tend            Set by the runner (--years, default 200).  The published
!                   7e11 s is ~22,000 model years, which is far more than any
!                   of these cases needs -- equilibria converge in 15-60 -- and
!                   becomes a problem once dt is reduced for stability: a
!                   runaway case at dt = 100 s would spend hours integrating
!                   toward a temperature that does not exist.
!   dt              Set PER CASE by the runner from a diffusion stability
!                   limit, capped at the published 1350 s.  HEXTOR integrates
!                   the diffusion term explicitly on 18 belts in x = sin(lat),
!                   so it needs D*dt/(C*dx^2) below ~1/2.  At 1350 s that is
!                   0.9 for the fixed transport at 10 bar and 5.4 for the
!                   rotation-scaled transport, and the latter silently
!                   integrates to NaN after 5000 years rather than failing.
!                   Verified: the same case gives NaN at 1350 s, 289.34 K at
!                   400 s and 289.35 K at 135 s.
!   heat capacity   constheatcap = .true. with heatcap = 4.00e6, the published
!                   TRAPPIST-1 value.  The protocol specifies a 50 m slab
!                   (2.1e8 J/m2/K), but heat capacity sets only the approach to
!                   equilibrium, not the equilibrium itself, and matching the
!                   published configuration matters more here.
! ---------------------------------------------------------------------------

 &ebm
   seasons	= .true.,
   do_manualseasons = .false.,
   tempinit     = {tempinit},
   resfile      = 0,
   tend		= {tend},
   dt		= {dt},
   rot		= 4.84813681e-6,
   a		= 8.783631e11,
   ecc		= 0.0,
   peri         = 0.0,
   obl		= 0.0,
   d0           = {d0},
   diffadj      = {diffadj},
   diffadj_rot  = {diffadj_rot},
   pg0          = {pg0},
   fco2         = {fco2},
   fh2          = 0.0,
   ocean	= 1.0,
   igeog        = 4,
   constheatcap = .true.,
   heatcap      = 4.00e6,
   yrstep       = 1,
   msun         = 2.38692e32,
   iterhalt     = .true.,
   do_longitudinal = .true.,
   haltonCO2cond = .false.,
   fluxcnvg      = 5.e-4 /
! fluxcnvg is tightened from the published 0.005 because at 0.005 these cases
! halt with the global mean still drifting ~0.2 K/decade; 5e-4 costs only a few
! extra model years and brings the drift to ~0.03 K/decade.  Note it does NOT
! remove the residual top-of-atmosphere imbalance: HEXTOR closes its global
! budget to about 1 W/m2 on the 18-belt grid (pre-industrial Earth sits at
! -0.91 W/m2), and the discretisation of the dayside insolation alone carries
! +0.86 W/m2.  The temperature trend, not the imbalance, is the meaningful
! convergence test here.

 &radiation
   relsolcon	 = 1.0,
   solarcon      = {solarcon},
   radparam      = 3,
   radfile       = '{radfile}',
   groundalb	 = 0.30,
   snowalb       = 0.21,
   oceanalbconst = .true.,
   ocnalb        = 0.06,
   landsnowfrac  = 1.00,
   cloudir	 = {cloudir},
   fcloud        = 0.0,
   cloudalb      = .false.,
   soladj        = .false.,
   linalb        = .false.,
   linrad        = .false. /

 &co2cycle
   do_cs_cycle  = .false.,
   outgassing   = 7.0,
   weathering   = 7.0,
   betaexp      = 0.50,
   kact         = 0.09,
   krun         = 0.045 /

 &h2cycle
   do_h2_cycle  = .false.,
   h2outgas     = 1.0e12 /

 &stochastic
   do_stochastic = .false.,
   noisevar      = 0.334 /
